# Database
# PostgreSQL is NOT provided by docker-compose.yml. Point these at an existing
# Supabase project or PostgreSQL server that is reachable from the containers.
# `localhost` resolves to the container itself — use host.docker.internal or a
# routable hostname instead.
# On Supabase, copy host, port, user and database from
# Project Settings -> Database. The direct connection and the connection pooler
# use different hostnames and ports.
DB_HOST=your-postgres-host
DB_USER=postgres
DB_PORT=5432
DB_PASSWORD=your_password
DB_NAME=postgres

# Creates and updates tables from the TypeORM entities on startup (synchronize).
# Leave disabled in production.
DB_MIGRATION_ENABLED=false

# Queue Database
# Currently unused: pgmq runs on the DB_* connection above. These variables are
# read into the config but no component consumes them, and docker-compose.yml
# does not pass them to the containers.
# QUEUE_DB_HOST=
# QUEUE_DB_USER=
# QUEUE_DB_PORT=
# QUEUE_DB_PASSWORD=
# QUEUE_DB_NAME=

# S3 Storage (required for file-runner)
S3_BUCKET_ID=prod
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
